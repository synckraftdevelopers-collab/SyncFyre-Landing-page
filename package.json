{
    "name":  "react-example",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx server.ts",
                    "build":  "powershell -Command \u0027npm run build:client; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; npm run build:server\u0027",
                    "build:client":  "vite build",
                    "build:server":  "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
                    "start":  "node dist/server.cjs",
                    "clean":  "powershell -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist }; if (Test-Path server.js) { Remove-Item -Force server.js }\"",
                    "lint":  "tsc --noEmit"
                },
    "dependencies":  {
                         "@google/genai":  "^2.4.0",
                         "@tailwindcss/vite":  "^4.1.14",
                         "@vitejs/plugin-react":  "^5.0.4",
                         "lucide-react":  "^0.546.0",
                         "react":  "^19.0.1",
                         "react-dom":  "^19.0.1",
                         "vite":  "^6.2.3",
                         "express":  "^4.21.2",
                         "dotenv":  "^17.2.3",
                         "motion":  "^12.23.24"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.14.0",
                            "autoprefixer":  "^10.4.21",
                            "esbuild":  "^0.25.0",
                            "tailwindcss":  "^4.1.14",
                            "tsx":  "^4.21.0",
                            "typescript":  "~5.8.2",
                            "vite":  "^6.2.3",
                            "@types/express":  "^4.17.21"
                        }
}
